# From the Google OAuth client JSON (web client)
GMAIL_CLIENT_ID=your_client_id
GMAIL_CLIENT_SECRET=your_client_secret
# Obtained once via OAuth Playground with scope https://www.googleapis.com/auth/gmail.send
GMAIL_REFRESH_TOKEN=your_refresh_token
# Optional: address shown in From (must be the authorised Gmail account)
GMAIL_SENDER=
# Optional: comma-separated allowlist, e.g. gmail.com,yourcompany.com
EMAIL_ALLOWED_DOMAINS=
